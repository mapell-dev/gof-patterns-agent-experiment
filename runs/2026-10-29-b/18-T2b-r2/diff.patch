+}
 
-public static class PriceCalculator
+// Strategy: each discount rule takes the amount left after the previous rules
+// and returns the amount left after its own discount.
+public interface IDiscountRule
+{
+    decimal Apply(Order order, decimal amount);
+}
+
+public sealed class CustomerDiscount : IDiscountRule
 {
-    public static decimal Total(Order order)
+    public decimal Apply(Order order, decimal amount) => order.Customer switch
     {
-        var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
-        {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
-        };
-        return subtotal - discount;
-    }
+        CustomerType.Loyal => amount - amount * 0.05m,
+        _ => amount
+    };
+}
+
+public sealed class LargeOrderDiscount : IDiscountRule
+{
+    public const decimal Threshold = 1000m;
+
+    public decimal Apply(Order order, decimal amount) =>
+        order.Subtotal >= Threshold ? amount - amount * 0.03m : amount;
+}
+
+public static class PriceCalculator
+{
+    // Order matters: the large-order discount applies to what is left after the customer discount.
+    private static readonly IReadOnlyList<IDiscountRule> Rules =
+        [new CustomerDiscount(), new LargeOrderDiscount()];
+
+    public static decimal Total(Order order) =>
+        Rules.Aggregate(order.Subtotal, (amount, rule) => rule.Apply(order, amount));
 }
