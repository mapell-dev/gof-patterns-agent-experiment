@@ -1,21 +1,86 @@
+using System.Globalization;
+
 namespace Shop;
 
-public enum CustomerType { Regular, Loyal }
+public enum CustomerType { Regular, Loyal, Student, Partner }
 
 public record OrderLine(string Sku, decimal UnitPrice, int Quantity);
 
 public record Order(CustomerType Customer, IReadOnlyList<OrderLine> Lines);
 
+public record Receipt(decimal Subtotal, decimal Discount, decimal Total, string DiscountLine);
+
 public static class PriceCalculator
 {
-    public static decimal Total(Order order)
+    public static decimal Total(Order order) => Receipt(order).Total;
+
+    public static Receipt Receipt(Order order)
     {
         var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
+        var rule = Discounts.For(order.Customer);
+        var discount = rule.DiscountFor(subtotal);
+        return new Receipt(subtotal, discount, subtotal - discount, $"{order.Customer}: {rule.Description}");
+    }
+}
+
+/// <summary>
+/// One discount rule per customer type. To add a customer type, add the enum value
+/// and one entry here; a test checks that every customer type has a rule.
+/// </summary>
+public static class Discounts
+{
+    private static readonly IReadOnlyDictionary<CustomerType, IDiscountRule> Rules =
+        new Dictionary<CustomerType, IDiscountRule>
         {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
+            [CustomerType.Regular] = new NoDiscount(),
+            [CustomerType.Loyal] = new PercentOff(5m),
+            [CustomerType.Student] = new CappedPercentOff(10m, Max: 30m),
+            [CustomerType.Partner] = new TieredPercentOff(10m, Threshold: 1000m, PercentAboveThreshold: 15m),
         };
-        return subtotal - discount;
-    }
+
+    public static IDiscountRule For(CustomerType customer) =>
+        Rules.TryGetValue(customer, out var rule)
+            ? rule
+            : throw new InvalidOperationException($"No discount rule defined for customer type {customer}.");
+}
+
+public interface IDiscountRule
+{
+    decimal DiscountFor(decimal subtotal);
+
+    /// <summary>Text shown on the receipt after the customer type, e.g. "5% off".</summary>
+    string Description { get; }
+}
+
+public record NoDiscount : IDiscountRule
+{
+    public decimal DiscountFor(decimal subtotal) => 0m;
+    public string Description => "no discount";
+}
+
+public record PercentOff(decimal Percent) : IDiscountRule
+{
+    public decimal DiscountFor(decimal subtotal) => subtotal * Percent / 100m;
+    public string Description => $"{Format.Number(Percent)}% off";
+}
+
+public record CappedPercentOff(decimal Percent, decimal Max) : IDiscountRule
+{
+    public decimal DiscountFor(decimal subtotal) => Math.Min(subtotal * Percent / 100m, Max);
+    public string Description => $"{Format.Number(Percent)}% off, max {Format.Number(Max)}";
+}
+
+/// <summary>Percent off the whole order, with a higher percent once the subtotal exceeds the threshold.</summary>
+public record TieredPercentOff(decimal Percent, decimal Threshold, decimal PercentAboveThreshold) : IDiscountRule
+{
+    public decimal DiscountFor(decimal subtotal) =>
+        subtotal * (subtotal > Threshold ? PercentAboveThreshold : Percent) / 100m;
+
+    public string Description =>
+        $"{Format.Number(Percent)}% off, {Format.Number(PercentAboveThreshold)}% off above {Format.Number(Threshold)}";
+}
+
+internal static class Format
+{
+    public static string Number(decimal value) => value.ToString("#,0.##", CultureInfo.InvariantCulture);
 }
