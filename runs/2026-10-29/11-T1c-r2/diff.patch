diff --git a/Shop/Discounts.cs b/Shop/Discounts.cs
new file mode 100644
index 0000000..62fd92e
--- /dev/null
+++ b/Shop/Discounts.cs
@@ -0,0 +1,42 @@
+namespace Shop;
+
+/// <summary>Discount rule for one customer type. Returns the amount to take off the subtotal.</summary>
+public interface ICustomerDiscount
+{
+    decimal DiscountOn(decimal subtotal);
+}
+
+public sealed class NoDiscount : ICustomerDiscount
+{
+    public decimal DiscountOn(decimal subtotal) => 0m;
+}
+
+public sealed class LoyalDiscount : ICustomerDiscount
+{
+    public decimal DiscountOn(decimal subtotal) => subtotal * 0.05m;
+}
+
+public sealed class EmployeeDiscount : ICustomerDiscount
+{
+    public decimal DiscountOn(decimal subtotal) => subtotal * 0.20m;
+}
+
+/// <summary>
+/// Maps each customer type to its discount. To add a customer type: add the enum value,
+/// write a new ICustomerDiscount class, and register it here. Existing discounts stay untouched.
+/// </summary>
+public static class CustomerDiscounts
+{
+    private static readonly IReadOnlyDictionary<CustomerType, ICustomerDiscount> ByType =
+        new Dictionary<CustomerType, ICustomerDiscount>
+        {
+            [CustomerType.Regular] = new NoDiscount(),
+            [CustomerType.Loyal] = new LoyalDiscount(),
+            [CustomerType.Employee] = new EmployeeDiscount(),
+        };
+
+    public static ICustomerDiscount For(CustomerType customer) =>
+        ByType.TryGetValue(customer, out var discount)
+            ? discount
+            : throw new InvalidOperationException($"No discount registered for customer type {customer}.");
+}
