+++ b/Shop/Receipt.cs
@@ -0,0 +1,23 @@
+using System.Globalization;
+
+namespace Shop;
+
+public static class Receipt
+{
+    public static IReadOnlyList<string> Lines(Order order)
+    {
+        var lines = order.Lines
+            .Select(l => $"{l.Sku} {l.Quantity} x {Money(l.UnitPrice)} = {Money(l.UnitPrice * l.Quantity)}")
+            .ToList();
+        lines.Add($"Subtotal: {Money(PriceCalculator.Subtotal(order))}");
+        lines.Add(DiscountLine(order));
+        lines.Add($"Discount: -{Money(PriceCalculator.Discount(order))}");
+        lines.Add($"Total: {Money(PriceCalculator.Total(order))}");
+        return lines;
+    }
+
+    public static string DiscountLine(Order order) =>
+        $"{order.Customer}: {DiscountCatalog.For(order.Customer).Description}";
+
+    private static string Money(decimal amount) => amount.ToString("0.00", CultureInfo.InvariantCulture);
+}
