 namespace Shop;
 
-public enum CustomerType { Regular, Loyal }
+public enum CustomerType { Regular, Loyal, Student, Partner }
 
 public record OrderLine(string Sku, decimal UnitPrice, int Quantity);
 
 public record Order(CustomerType Customer, IReadOnlyList<OrderLine> Lines);
 
+// One discount rule per customer type: the amount and its receipt line live together
+// so they cannot drift apart. A new customer type = one enum value, one class, one map entry.
+public interface IDiscount
+{
+    decimal Amount(decimal subtotal);
+    string Description { get; }
+}
+
+public sealed class NoDiscount : IDiscount
+{
+    public decimal Amount(decimal subtotal) => 0m;
+    public string Description => "Regular: no discount";
+}
+
+public sealed class LoyalDiscount : IDiscount
+{
+    public decimal Amount(decimal subtotal) => subtotal * 0.05m;
+    public string Description => "Loyal: 5% off";
+}
+
+public sealed class StudentDiscount : IDiscount
+{
+    private const decimal Cap = 30m;
+    public decimal Amount(decimal subtotal) => Math.Min(subtotal * 0.10m, Cap);
+    public string Description => "Student: 10% off, max 30";
+}
+
+public sealed class PartnerDiscount : IDiscount
+{
+    private const decimal Threshold = 1000m;
+    public decimal Amount(decimal subtotal) => subtotal * (subtotal > Threshold ? 0.15m : 0.10m);
+    public string Description => "Partner: 10% off, 15% off above 1,000";
+}
+
+public static class Discounts
+{
+    private static readonly IReadOnlyDictionary<CustomerType, IDiscount> ByCustomer =
+        new Dictionary<CustomerType, IDiscount>
+        {
+            [CustomerType.Regular] = new NoDiscount(),
+            [CustomerType.Loyal] = new LoyalDiscount(),
+            [CustomerType.Student] = new StudentDiscount(),
+            [CustomerType.Partner] = new PartnerDiscount(),
+        };
+
+    public static IDiscount For(CustomerType customer) =>
+        ByCustomer.TryGetValue(customer, out var discount)
+            ? discount
+            : throw new ArgumentOutOfRangeException(nameof(customer), customer, "No discount rule registered.");
+}
+
 public static class PriceCalculator
 {
+    public static decimal Subtotal(Order order) => order.Lines.Sum(l => l.UnitPrice * l.Quantity);
+
     public static decimal Total(Order order)
     {
-        var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
-        {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
-        };
-        return subtotal - discount;
+        var subtotal = Subtotal(order);
+        return subtotal - Discounts.For(order.Customer).Amount(subtotal);
     }
+
+    public static string DiscountReceiptLine(Order order) => Discounts.For(order.Customer).Description;
 }
