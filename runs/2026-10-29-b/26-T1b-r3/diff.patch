 namespace Shop;
 
-public enum CustomerType { Regular, Loyal }
+public enum CustomerType { Regular, Loyal, Employee }
 
 public record OrderLine(string Sku, decimal UnitPrice, int Quantity);
 
 public record Order(CustomerType Customer, IReadOnlyList<OrderLine> Lines);
 
+public interface IDiscountStrategy
+{
+    decimal DiscountFor(decimal subtotal);
+}
+
+public sealed class NoDiscount : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal) => 0m;
+}
+
+public sealed class PercentageDiscount(decimal rate) : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal) => subtotal * rate;
+}
+
+public static class DiscountStrategies
+{
+    // To add a customer type: add it to CustomerType and register its strategy here.
+    private static readonly IReadOnlyDictionary<CustomerType, IDiscountStrategy> ByCustomer =
+        new Dictionary<CustomerType, IDiscountStrategy>
+        {
+            [CustomerType.Regular] = new NoDiscount(),
+            [CustomerType.Loyal] = new PercentageDiscount(0.05m),
+            [CustomerType.Employee] = new PercentageDiscount(0.20m),
+        };
+
+    public static IDiscountStrategy For(CustomerType customer) =>
+        ByCustomer.TryGetValue(customer, out var strategy)
+            ? strategy
+            : throw new InvalidOperationException($"No discount strategy registered for customer type '{customer}'.");
+}
+
 public static class PriceCalculator
 {
     public static decimal Total(Order order)
     {
         var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
-        {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
-        };
+        var discount = DiscountStrategies.For(order.Customer).DiscountFor(subtotal);
         return subtotal - discount;
     }
 }
