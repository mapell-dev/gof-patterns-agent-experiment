diff --git a/Shop/DiscountStrategies.cs b/Shop/DiscountStrategies.cs
new file mode 100644
index 0000000..99f3cf2
--- /dev/null
+++ b/Shop/DiscountStrategies.cs
@@ -0,0 +1,67 @@
+namespace Shop;
+
+/// <summary>
+/// A customer type's discount rule. To add a customer type: add the enum value,
+/// write a strategy class, and register it in <see cref="DiscountStrategies"/>.
+/// </summary>
+public interface IDiscountStrategy
+{
+    CustomerType Customer { get; }
+
+    /// <summary>The single line describing this discount on the receipt.</summary>
+    string ReceiptLine { get; }
+
+    decimal DiscountFor(decimal subtotal);
+}
+
+public sealed class NoDiscount : IDiscountStrategy
+{
+    public CustomerType Customer => CustomerType.Regular;
+    public string ReceiptLine => "Regular: no discount";
+    public decimal DiscountFor(decimal subtotal) => 0m;
+}
+
+public sealed class LoyalDiscount : IDiscountStrategy
+{
+    public CustomerType Customer => CustomerType.Loyal;
+    public string ReceiptLine => "Loyal: 5% off";
+    public decimal DiscountFor(decimal subtotal) => subtotal * 0.05m;
+}
+
+public sealed class StudentDiscount : IDiscountStrategy
+{
+    private const decimal Cap = 30m;
+
+    public CustomerType Customer => CustomerType.Student;
+    public string ReceiptLine => "Student: 10% off, max 30";
+    public decimal DiscountFor(decimal subtotal) => Math.Min(subtotal * 0.10m, Cap);
+}
+
+public sealed class PartnerDiscount : IDiscountStrategy
+{
+    private const decimal Threshold = 1000m;
+
+    public CustomerType Customer => CustomerType.Partner;
+    public string ReceiptLine => "Partner: 10% off, 15% off above 1,000";
+    public decimal DiscountFor(decimal subtotal) =>
+        subtotal * (subtotal > Threshold ? 0.15m : 0.10m);
+}
+
+public static class DiscountStrategies
+{
+    public static readonly IReadOnlyList<IDiscountStrategy> All =
+    [
+        new NoDiscount(),
+        new LoyalDiscount(),
+        new StudentDiscount(),
+        new PartnerDiscount(),
+    ];
+
+    private static readonly IReadOnlyDictionary<CustomerType, IDiscountStrategy> ByCustomer =
+        All.ToDictionary(s => s.Customer);
+
+    public static IDiscountStrategy For(CustomerType customer) =>
+        ByCustomer.TryGetValue(customer, out var strategy)
+            ? strategy
+            : throw new InvalidOperationException($"No discount strategy registered for {customer}.");
+}
