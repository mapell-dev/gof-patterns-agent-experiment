+using Shop;
+
+public class DiscountTests
+{
+    [Fact]
+    public void No_discount_takes_nothing_off() =>
+        Assert.Equal(0m, new NoDiscount().DiscountFor(200m));
+
+    [Fact]
+    public void Loyal_discount_is_five_percent() =>
+        Assert.Equal(10m, new LoyalDiscount().DiscountFor(200m));
+
+    [Fact]
+    public void Employee_discount_is_twenty_percent() =>
+        Assert.Equal(40m, new EmployeeDiscount().DiscountFor(200m));
+}
