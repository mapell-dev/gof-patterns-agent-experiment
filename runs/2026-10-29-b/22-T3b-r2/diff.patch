diff --git a/Shop/Pricing.cs b/Shop/Pricing.cs
index 1628253..3660053 100644
--- a/Shop/Pricing.cs
+++ b/Shop/Pricing.cs
@@ -1,21 +1,79 @@
 namespace Shop;
 
-public enum CustomerType { Regular, Loyal }
+public enum CustomerType { Regular, Loyal, Student, Partner }
 
 public record OrderLine(string Sku, decimal UnitPrice, int Quantity);
 
 public record Order(CustomerType Customer, IReadOnlyList<OrderLine> Lines);
 
+public record Receipt(decimal Subtotal, string DiscountLine, decimal Discount, decimal Total);
+
+/// <summary>A customer type's discount rule and how it is described on the receipt.</summary>
+public interface IDiscountStrategy
+{
+    decimal DiscountFor(decimal subtotal);
+    string Description { get; }
+}
+
+public sealed class NoDiscount : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal) => 0m;
+    public string Description => "Regular: no discount";
+}
+
+public sealed class LoyalDiscount : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal) => subtotal * 0.05m;
+    public string Description => "Loyal: 5% off";
+}
+
+public sealed class StudentDiscount : IDiscountStrategy
+{
+    private const decimal MaxDiscount = 30m;
+
+    public decimal DiscountFor(decimal subtotal) => Math.Min(subtotal * 0.10m, MaxDiscount);
+    public string Description => "Student: 10% off, max 30";
+}
+
+public sealed class PartnerDiscount : IDiscountStrategy
+{
+    private const decimal Threshold = 1_000m;
+
+    public decimal DiscountFor(decimal subtotal) =>
+        subtotal * (subtotal > Threshold ? 0.15m : 0.10m);
+    public string Description => "Partner: 10% off, 15% above 1,000";
+}
+
+/// <summary>
+/// The single place that maps a customer type to its discount strategy.
+/// To add a customer type: add the enum value, write an IDiscountStrategy, register it here.
+/// </summary>
+public static class DiscountStrategies
+{
+    private static readonly IReadOnlyDictionary<CustomerType, IDiscountStrategy> ByCustomer =
+        new Dictionary<CustomerType, IDiscountStrategy>
+        {
+            [CustomerType.Regular] = new NoDiscount(),
+            [CustomerType.Loyal] = new LoyalDiscount(),
+            [CustomerType.Student] = new StudentDiscount(),
+            [CustomerType.Partner] = new PartnerDiscount(),
+        };
+
+    public static IDiscountStrategy For(CustomerType customer) =>
+        ByCustomer.TryGetValue(customer, out var strategy)
+            ? strategy
+            : throw new ArgumentOutOfRangeException(nameof(customer), customer, "No discount strategy registered.");
+}
+
 public static class PriceCalculator
 {
-    public static decimal Total(Order order)
+    public static decimal Total(Order order) => Receipt(order).Total;
+
+    public static Receipt Receipt(Order order)
     {
         var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
-        {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
-        };
-        return subtotal - discount;
+        var strategy = DiscountStrategies.For(order.Customer);
+        var discount = strategy.DiscountFor(subtotal);
+        return new Receipt(subtotal, strategy.Description, discount, subtotal - discount);
     }
 }
