@@ -0,0 +1,22 @@
+using Shop;
+
+public class DiscountTests
+{
+    [Fact]
+    public void No_discount_takes_nothing_off() =>
+        Assert.Equal(0m, new NoDiscount().Amount(250m));
+
+    [Theory]
+    [InlineData(0.05, 250, 12.50)]
+    [InlineData(0.20, 250, 50)]
+    [InlineData(0, 250, 0)]
+    [InlineData(1, 250, 250)]
+    public void Percentage_discount_takes_its_rate_off_the_subtotal(decimal rate, decimal subtotal, decimal expected) =>
+        Assert.Equal(expected, new PercentageDiscount(rate).Amount(subtotal));
+
+    [Theory]
+    [InlineData(-0.01)]
+    [InlineData(1.01)]
+    public void Percentage_discount_rejects_rates_outside_zero_to_one(decimal rate) =>
+        Assert.Throws<ArgumentOutOfRangeException>(() => new PercentageDiscount(rate));
+}
