diff --git a/Shop/Discounts.cs b/Shop/Discounts.cs
new file mode 100644
index 0000000..6f914e2
--- /dev/null
+++ b/Shop/Discounts.cs
@@ -0,0 +1,60 @@
+using static System.FormattableString;
+
+namespace Shop;
+
+// To add a customer type: add the enum value, write an IDiscountStrategy, and register it below.
+public interface IDiscountStrategy
+{
+    decimal DiscountFor(decimal subtotal);
+
+    // The single line shown on the receipt, e.g. "Loyal: 5% off".
+    string Description { get; }
+}
+
+public static class DiscountStrategies
+{
+    private static readonly Dictionary<CustomerType, IDiscountStrategy> ByCustomer = new()
+    {
+        [CustomerType.Regular] = new NoDiscount("Regular"),
+        [CustomerType.Loyal] = new PercentOff("Loyal", 5m),
+        [CustomerType.Student] = new CappedPercentOff("Student", 10m, 30m),
+        [CustomerType.Partner] = new TieredPercentOff("Partner", 10m, 1000m, 15m),
+    };
+
+    public static IDiscountStrategy For(CustomerType customer) =>
+        ByCustomer.TryGetValue(customer, out var strategy)
+            ? strategy
+            : throw new InvalidOperationException($"No discount strategy registered for {customer}.");
+}
+
+public sealed class NoDiscount(string name) : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal) => 0m;
+
+    public string Description => $"{name}: no discount";
+}
+
+public sealed class PercentOff(string name, decimal percent) : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal) => subtotal * percent / 100m;
+
+    public string Description => Invariant($"{name}: {percent:0.##}% off");
+}
+
+public sealed class CappedPercentOff(string name, decimal percent, decimal maxDiscount) : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal) => Math.Min(subtotal * percent / 100m, maxDiscount);
+
+    public string Description => Invariant($"{name}: {percent:0.##}% off, max {maxDiscount:0.##}");
+}
+
+// Applies basePercent up to and including the threshold, and higherPercent to the whole order above it.
+public sealed class TieredPercentOff(string name, decimal basePercent, decimal threshold, decimal higherPercent)
+    : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal) =>
+        subtotal * (subtotal > threshold ? higherPercent : basePercent) / 100m;
+
+    public string Description =>
+        Invariant($"{name}: {basePercent:0.##}% off, {higherPercent:0.##}% off over {threshold:#,0.##}");
+}
