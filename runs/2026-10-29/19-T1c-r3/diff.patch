@@ -0,0 +1,20 @@
+using Shop;
+
+public class DiscountTests
+{
+    [Fact]
+    public void Loyal_discount_is_five_percent_of_the_subtotal() =>
+        Assert.Equal(5m, new LoyalDiscount().DiscountOn(100m));
+
+    [Fact]
+    public void Loyal_discount_applies_to_loyal_customers() =>
+        Assert.Equal(CustomerType.Loyal, new LoyalDiscount().Customer);
+
+    [Fact]
+    public void Employee_discount_is_twenty_percent_of_the_subtotal() =>
+        Assert.Equal(20m, new EmployeeDiscount().DiscountOn(100m));
+
+    [Fact]
+    public void Employee_discount_applies_to_employees() =>
+        Assert.Equal(CustomerType.Employee, new EmployeeDiscount().Customer);
+}
