 public static class PriceCalculator
 {
-    public static decimal Total(Order order)
+    public static decimal Total(Order order) => Total(order, Discounts.All);
+
+    public static decimal Total(Order order, IEnumerable<ICustomerDiscount> discounts)
     {
         var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
-        {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
-        };
+        var discount = discounts.FirstOrDefault(d => d.Customer == order.Customer)?.AmountOff(subtotal) ?? 0m;
         return subtotal - discount;
     }
 }
