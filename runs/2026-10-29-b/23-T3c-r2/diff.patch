+using Shop;
+using Shop.Discounts;
+
+public class DiscountTests
+{
+    [Fact]
+    public void No_discount_is_zero() =>
+        Assert.Equal(0m, new NoDiscount().AmountFor(250m));
+
+    [Fact]
+    public void Loyal_is_five_percent() =>
+        Assert.Equal(12.50m, new LoyalDiscount().AmountFor(250m));
+
+    [Theory]
+    [InlineData(250, 25)]   // 10% below the cap
+    [InlineData(300, 30)]   // exactly at the cap
+    [InlineData(1000, 30)]  // capped
+    public void Student_is_ten_percent_capped_at_30(decimal subtotal, decimal expected) =>
+        Assert.Equal(expected, new StudentDiscount().AmountFor(subtotal));
+
+    [Theory]
+    [InlineData(500, 50)]       // 10%
+    [InlineData(1000, 100)]     // "up to 1,000" is inclusive: still 10%
+    [InlineData(1000.01, 150.0015)] // above 1,000: 15% of the whole order
+    [InlineData(2000, 300)]
+    public void Partner_is_ten_percent_up_to_1000_and_fifteen_above(decimal subtotal, decimal expected) =>
+        Assert.Equal(expected, new PartnerDiscount().AmountFor(subtotal));
+
+    [Fact]
+    public void Every_customer_type_has_a_discount_registered()
+    {
+        foreach (var customer in Enum.GetValues<CustomerType>())
+            Assert.NotNull(CustomerDiscounts.For(customer));
+    }
+}
