@@ -0,0 +1,62 @@
+using Shop;
+
+public class NoDiscountTests
+{
+    [Fact]
+    public void Takes_nothing_off() => Assert.Equal(0m, new NoDiscount().AmountFor(250m));
+
+    [Fact]
+    public void Describes_itself() => Assert.Equal("no discount", new NoDiscount().Description);
+}
+
+public class PercentageDiscountTests
+{
+    [Fact]
+    public void Takes_the_percentage_of_the_subtotal() =>
+        Assert.Equal(12.50m, new PercentageDiscount(5m).AmountFor(250m));
+
+    [Fact]
+    public void Describes_itself() => Assert.Equal("5% off", new PercentageDiscount(5m).Description);
+}
+
+public class CappedPercentageDiscountTests
+{
+    private readonly CappedPercentageDiscount _discount = new(10m, cap: 30m);
+
+    [Theory]
+    [InlineData(250, 25)]
+    [InlineData(300, 30)]
+    [InlineData(400, 30)]
+    [InlineData(5000, 30)]
+    public void Takes_the_percentage_but_never_more_than_the_cap(decimal subtotal, decimal expected) =>
+        Assert.Equal(expected, _discount.AmountFor(subtotal));
+
+    [Fact]
+    public void Describes_itself() => Assert.Equal("10% off, max 30", _discount.Description);
+}
+
+public class TieredPercentageDiscountTests
+{
+    private readonly TieredPercentageDiscount _discount = new(10m, threshold: 1000m, percentAbove: 15m);
+
+    [Theory]
+    [InlineData(500, 50)]
+    [InlineData(1000, 100)]
+    [InlineData(1001, 150.15)]
+    [InlineData(1200, 180)]
+    public void Takes_the_higher_percentage_of_the_whole_subtotal_above_the_threshold(decimal subtotal, decimal expected) =>
+        Assert.Equal(expected, _discount.AmountFor(subtotal));
+
+    [Fact]
+    public void Describes_itself() => Assert.Equal("10% off, 15% off above 1,000", _discount.Description);
+}
+
+public class DiscountCatalogTests
+{
+    public static TheoryData<CustomerType> AllCustomerTypes => new(Enum.GetValues<CustomerType>());
+
+    [Theory]
+    [MemberData(nameof(AllCustomerTypes))]
+    public void Every_customer_type_has_a_discount_rule(CustomerType customer) =>
+        Assert.NotNull(DiscountCatalog.For(customer));
+}
