@@ -0,0 +1,30 @@
+using Shop;
+
+public class ReceiptTests
+{
+    private static Order OrderOf(CustomerType customer) =>
+        new(customer, [new OrderLine("A", 100m, 2), new OrderLine("B", 50m, 1)]);
+
+    [Theory]
+    [InlineData(CustomerType.Regular, "Regular: no discount")]
+    [InlineData(CustomerType.Loyal, "Loyal: 5% off")]
+    [InlineData(CustomerType.Student, "Student: 10% off, max 30")]
+    [InlineData(CustomerType.Partner, "Partner: 10% off, 15% off above 1,000")]
+    public void Shows_the_customer_discount_as_one_line(CustomerType customer, string expected) =>
+        Assert.Contains(expected, Receipt.Lines(OrderOf(customer)));
+
+    [Fact]
+    public void Lists_items_subtotal_discount_and_total()
+    {
+        string[] expected =
+        [
+            "A 2 x 100.00 = 200.00",
+            "B 1 x 50.00 = 50.00",
+            "Subtotal: 250.00",
+            "Student: 10% off, max 30",
+            "Discount: -25.00",
+            "Total: 225.00",
+        ];
+        Assert.Equal(expected, Receipt.Lines(OrderOf(CustomerType.Student)));
+    }
+}
diff --git a/Shop/Discounts.cs b/Shop/Discounts.cs
new file mode 100644
index 0000000..236abb2
--- /dev/null
+++ b/Shop/Discounts.cs
@@ -0,0 +1,70 @@
+using System.Globalization;
+
+namespace Shop;
+
+/// <summary>A discount rule: how much to take off a subtotal, and how to describe it on a receipt.</summary>
+public interface IDiscount
+{
+    decimal AmountFor(decimal subtotal);
+
+    /// <summary>Text shown after the customer type on the receipt, e.g. "5% off".</summary>
+    string Description { get; }
+}
+
+public sealed class NoDiscount : IDiscount
+{
+    public decimal AmountFor(decimal subtotal) => 0m;
+
+    public string Description => "no discount";
+}
+
+public sealed class PercentageDiscount(decimal percent) : IDiscount
+{
+    public decimal AmountFor(decimal subtotal) => subtotal * percent / 100m;
+
+    public string Description => $"{Format.Percent(percent)} off";
+}
+
+public sealed class CappedPercentageDiscount(decimal percent, decimal cap) : IDiscount
+{
+    public decimal AmountFor(decimal subtotal) => Math.Min(subtotal * percent / 100m, cap);
+
+    public string Description => $"{Format.Percent(percent)} off, max {Format.Amount(cap)}";
+}
+
+/// <summary>
+/// <paramref name="percent"/> off when the subtotal is up to and including <paramref name="threshold"/>;
+/// <paramref name="percentAbove"/> off the whole subtotal when it is above the threshold.
+/// </summary>
+public sealed class TieredPercentageDiscount(decimal percent, decimal threshold, decimal percentAbove) : IDiscount
+{
+    public decimal AmountFor(decimal subtotal) =>
+        subtotal * (subtotal > threshold ? percentAbove : percent) / 100m;
+
+    public string Description =>
+        $"{Format.Percent(percent)} off, {Format.Percent(percentAbove)} off above {Format.Amount(threshold)}";
+}
+
+/// <summary>The one place that says which discount rule applies to which customer type.</summary>
+public static class DiscountCatalog
+{
+    private static readonly Dictionary<CustomerType, IDiscount> Rules = new()
+    {
+        [CustomerType.Regular] = new NoDiscount(),
+        [CustomerType.Loyal] = new PercentageDiscount(5m),
+        [CustomerType.Student] = new CappedPercentageDiscount(10m, cap: 30m),
+        [CustomerType.Partner] = new TieredPercentageDiscount(10m, threshold: 1000m, percentAbove: 15m),
+    };
+
+    public static IDiscount For(CustomerType customer) =>
+        Rules.TryGetValue(customer, out var rule)
+            ? rule
+            : throw new InvalidOperationException($"No discount rule registered for customer type {customer}.");
+}
+
+internal static class Format
+{
+    public static string Percent(decimal percent) => percent.ToString("0.##", CultureInfo.InvariantCulture) + "%";
+
+    public static string Amount(decimal amount) => amount.ToString("#,0.##", CultureInfo.InvariantCulture);
+}
