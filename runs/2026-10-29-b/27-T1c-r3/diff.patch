@@ -0,0 +1,22 @@
+namespace Shop;
+
+/// <summary>The discount a customer type receives on an order subtotal.</summary>
+public interface ICustomerDiscount
+{
+    decimal DiscountFor(decimal subtotal);
+}
+
+public sealed class NoDiscount : ICustomerDiscount
+{
+    public decimal DiscountFor(decimal subtotal) => 0m;
+}
+
+public sealed class LoyalDiscount : ICustomerDiscount
+{
+    public decimal DiscountFor(decimal subtotal) => subtotal * 0.05m;
+}
+
+public sealed class EmployeeDiscount : ICustomerDiscount
+{
+    public decimal DiscountFor(decimal subtotal) => subtotal * 0.20m;
+}
