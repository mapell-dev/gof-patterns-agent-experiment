+using Shop;
+
+public class DiscountTests
+{
+    [Fact]
+    public void No_discount_takes_nothing_off() =>
+        Assert.Equal(0m, new NoDiscount().AmountOff(100m));
+
+    [Fact]
+    public void Loyal_discount_takes_five_percent_off() =>
+        Assert.Equal(5m, new LoyalDiscount().AmountOff(100m));
+
+    [Fact]
+    public void Employee_discount_takes_twenty_percent_off() =>
+        Assert.Equal(20m, new EmployeeDiscount().AmountOff(100m));
+}
