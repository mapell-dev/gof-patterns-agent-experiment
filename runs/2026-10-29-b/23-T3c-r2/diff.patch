@@ -0,0 +1,11 @@
+namespace Shop.Discounts;
+
+/// <summary>A customer type's discount rule. One implementation per customer type.</summary>
+public interface IDiscount
+{
+    /// <summary>Discount amount to subtract from the given subtotal.</summary>
+    decimal AmountFor(decimal subtotal);
+
+    /// <summary>Human-readable rule shown on the receipt, e.g. "5% off".</summary>
+    string Description { get; }
+}
