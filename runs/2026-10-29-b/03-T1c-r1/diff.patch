 namespace Shop;
 
-public enum CustomerType { Regular, Loyal }
+public enum CustomerType { Regular, Loyal, Employee }
 
 public record OrderLine(string Sku, decimal UnitPrice, int Quantity);
 
@@ -8,14 +8,21 @@ public record Order(CustomerType Customer, IReadOnlyList<OrderLine> Lines);
 
 public static class PriceCalculator
 {
+    // To add a customer type: add it to CustomerType, write its IDiscount, and register it here.
+    private static readonly IReadOnlyDictionary<CustomerType, IDiscount> Discounts =
+        new Dictionary<CustomerType, IDiscount>
+        {
+            [CustomerType.Regular] = new NoDiscount(),
+            [CustomerType.Loyal] = new LoyalDiscount(),
+            [CustomerType.Employee] = new EmployeeDiscount(),
+        };
+
     public static decimal Total(Order order)
     {
+        if (!Discounts.TryGetValue(order.Customer, out var discount))
+            throw new InvalidOperationException($"No discount registered for customer type {order.Customer}.");
+
         var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
-        {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
-        };
-        return subtotal - discount;
+        return subtotal - discount.AmountOff(subtotal);
     }
 }
