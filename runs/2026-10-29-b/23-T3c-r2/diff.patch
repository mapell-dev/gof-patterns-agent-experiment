diff --git a/Shop/Discounts/CustomerDiscounts.cs b/Shop/Discounts/CustomerDiscounts.cs
new file mode 100644
index 0000000..303c53a
--- /dev/null
+++ b/Shop/Discounts/CustomerDiscounts.cs
@@ -0,0 +1,22 @@
+namespace Shop.Discounts;
+
+/// <summary>
+/// Maps each customer type to its discount rule.
+/// To add a customer type: add the enum value, write a new IDiscount, and register it here.
+/// </summary>
+public static class CustomerDiscounts
+{
+    private static readonly IReadOnlyDictionary<CustomerType, IDiscount> Rules =
+        new Dictionary<CustomerType, IDiscount>
+        {
+            [CustomerType.Regular] = new NoDiscount(),
+            [CustomerType.Loyal] = new LoyalDiscount(),
+            [CustomerType.Student] = new StudentDiscount(),
+            [CustomerType.Partner] = new PartnerDiscount(),
+        };
+
+    public static IDiscount For(CustomerType customer) =>
+        Rules.TryGetValue(customer, out var discount)
+            ? discount
+            : throw new InvalidOperationException($"No discount registered for customer type {customer}.");
+}
diff --git a/Shop/Discounts/IDiscount.cs b/Shop/Discounts/IDiscount.cs
