new file mode 100644
index 0000000..79b829b
--- /dev/null
+++ b/Shop/Discounts/PartnerDiscount.cs
@@ -0,0 +1,12 @@
+namespace Shop.Discounts;
+
+public sealed class PartnerDiscount : IDiscount
+{
+    private const decimal Threshold = 1000m;
+
+    // The higher rate applies to the whole order, not just the part above the threshold.
+    public decimal AmountFor(decimal subtotal) =>
+        subtotal * (subtotal > Threshold ? 0.15m : 0.10m);
+
+    public string Description => "10% off, 15% off orders above 1,000";
+}
diff --git a/Shop/Discounts/StudentDiscount.cs b/Shop/Discounts/StudentDiscount.cs
new file mode 100644
index 0000000..9efc5df
--- /dev/null
+++ b/Shop/Discounts/StudentDiscount.cs
@@ -0,0 +1,10 @@
+namespace Shop.Discounts;
+
+public sealed class StudentDiscount : IDiscount
+{
+    private const decimal Cap = 30m;
+
+    public decimal AmountFor(decimal subtotal) => Math.Min(subtotal * 0.10m, Cap);
+
+    public string Description => "10% off, max 30";
+}
