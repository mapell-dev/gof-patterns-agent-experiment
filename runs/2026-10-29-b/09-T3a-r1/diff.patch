@@ -1,21 +1,71 @@
 namespace Shop;
 
-public enum CustomerType { Regular, Loyal }
+public enum CustomerType { Regular, Loyal, Student, Partner }
 
 public record OrderLine(string Sku, decimal UnitPrice, int Quantity);
 
 public record Order(CustomerType Customer, IReadOnlyList<OrderLine> Lines);
 
+public record Receipt(decimal Subtotal, decimal Discount, decimal Total, string DiscountLine);
+
+/// <summary>A customer type's discount rule and how it is described on the receipt.</summary>
+public interface IDiscountPolicy
+{
+    decimal DiscountFor(decimal subtotal);
+    string Description { get; }
+}
+
+public sealed class NoDiscount : IDiscountPolicy
+{
+    public decimal DiscountFor(decimal subtotal) => 0m;
+    public string Description => "no discount";
+}
+
+public sealed class LoyalDiscount : IDiscountPolicy
+{
+    public decimal DiscountFor(decimal subtotal) => subtotal * 0.05m;
+    public string Description => "5% off";
+}
+
+public sealed class StudentDiscount : IDiscountPolicy
+{
+    public decimal DiscountFor(decimal subtotal) => Math.Min(subtotal * 0.10m, 30m);
+    public string Description => "10% off, max 30";
+}
+
+public sealed class PartnerDiscount : IDiscountPolicy
+{
+    public decimal DiscountFor(decimal subtotal) => subtotal * (subtotal > 1000m ? 0.15m : 0.10m);
+    public string Description => "10% off, 15% off above 1,000";
+}
+
+public static class DiscountPolicies
+{
+    // To add a customer type: add it to CustomerType, write a policy, and register it here.
+    private static readonly IReadOnlyDictionary<CustomerType, IDiscountPolicy> ByCustomer =
+        new Dictionary<CustomerType, IDiscountPolicy>
+        {
+            [CustomerType.Regular] = new NoDiscount(),
+            [CustomerType.Loyal] = new LoyalDiscount(),
+            [CustomerType.Student] = new StudentDiscount(),
+            [CustomerType.Partner] = new PartnerDiscount(),
+        };
+
+    public static IDiscountPolicy For(CustomerType customer) =>
+        ByCustomer.TryGetValue(customer, out var policy)
+            ? policy
+            : throw new InvalidOperationException($"No discount policy registered for {customer}.");
+}
+
 public static class PriceCalculator
 {
-    public static decimal Total(Order order)
+    public static decimal Total(Order order) => Receipt(order).Total;
+
+    public static Receipt Receipt(Order order)
     {
         var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
-        {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
-        };
-        return subtotal - discount;
+        var policy = DiscountPolicies.For(order.Customer);
+        var discount = policy.DiscountFor(subtotal);
+        return new Receipt(subtotal, discount, subtotal - discount, $"{order.Customer}: {policy.Description}");
     }
 }
