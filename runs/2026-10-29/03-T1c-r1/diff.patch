diff --git a/Shop/Discounts.cs b/Shop/Discounts.cs
new file mode 100644
index 0000000..dff1d06
--- /dev/null
+++ b/Shop/Discounts.cs
@@ -0,0 +1,42 @@
+namespace Shop;
+
+/// <summary>Computes how much to take off an order's subtotal.</summary>
+public interface IDiscount
+{
+    decimal Amount(decimal subtotal);
+}
+
+public sealed class NoDiscount : IDiscount
+{
+    public decimal Amount(decimal subtotal) => 0m;
+}
+
+public sealed class PercentageDiscount : IDiscount
+{
+    public PercentageDiscount(decimal rate)
+    {
+        if (rate is < 0m or > 1m)
+            throw new ArgumentOutOfRangeException(nameof(rate), rate, "Rate must be between 0 and 1.");
+        Rate = rate;
+    }
+
+    public decimal Rate { get; }
+
+    public decimal Amount(decimal subtotal) => subtotal * Rate;
+}
+
+/// <summary>
+/// The discount each customer type gets. To add a customer type, add it to
+/// <see cref="CustomerType"/> and register its discount here. Discounts that
+/// aren't a flat percentage get their own <see cref="IDiscount"/> implementation.
+/// </summary>
+public static class Discounts
+{
+    public static IReadOnlyDictionary<CustomerType, IDiscount> ByCustomerType { get; } =
+        new Dictionary<CustomerType, IDiscount>
+        {
+            [CustomerType.Regular] = new NoDiscount(),
+            [CustomerType.Loyal] = new PercentageDiscount(0.05m),
+            [CustomerType.Employee] = new PercentageDiscount(0.20m),
+        };
+}
