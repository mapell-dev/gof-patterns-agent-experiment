+using Shop;
+
+public class DiscountTests
+{
+    [Fact]
+    public void No_discount_takes_nothing_off() =>
+        Assert.Equal(0m, new NoDiscount().DiscountOn(250m));
+
+    [Fact]
+    public void Loyal_discount_is_five_percent() =>
+        Assert.Equal(12.50m, new LoyalDiscount().DiscountOn(250m));
+
+    [Fact]
+    public void Employee_discount_is_twenty_percent() =>
+        Assert.Equal(50m, new EmployeeDiscount().DiscountOn(250m));
+
+    public static TheoryData<CustomerType> AllCustomerTypes() => new(Enum.GetValues<CustomerType>());
+
+    // Guards against adding a customer type without registering its discount.
+    [Theory]
+    [MemberData(nameof(AllCustomerTypes))]
+    public void Every_customer_type_has_a_discount(CustomerType customer) =>
+        Assert.NotNull(CustomerDiscounts.For(customer));
+}
