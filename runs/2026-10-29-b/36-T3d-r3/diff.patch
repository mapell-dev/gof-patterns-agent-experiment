diff --git a/Shop/Pricing.cs b/Shop/Pricing.cs
index 1628253..ac7a96a 100644
--- a/Shop/Pricing.cs
+++ b/Shop/Pricing.cs
@@ -1,21 +1,44 @@
 namespace Shop;
 
-public enum CustomerType { Regular, Loyal }
+public enum CustomerType { Regular, Loyal, Student, Partner }
 
 public record OrderLine(string Sku, decimal UnitPrice, int Quantity);
 
 public record Order(CustomerType Customer, IReadOnlyList<OrderLine> Lines);
 
+public record Receipt(decimal Subtotal, string DiscountLine, decimal Discount, decimal Total);
+
+// A customer type's discount rule: how much comes off a subtotal, and how that reads on a receipt.
+public record Discount(string Description, Func<decimal, decimal> AmountFor);
+
+public static class Discounts
+{
+    // To add a customer type: add it to CustomerType and give it one entry here.
+    public static readonly IReadOnlyDictionary<CustomerType, Discount> ByCustomer =
+        new Dictionary<CustomerType, Discount>
+        {
+            [CustomerType.Regular] = new("Regular: no discount", _ => 0m),
+            [CustomerType.Loyal] = new("Loyal: 5% off", s => s * 0.05m),
+            [CustomerType.Student] = new("Student: 10% off, max 30", s => Math.Min(s * 0.10m, 30m)),
+            [CustomerType.Partner] = new("Partner: 10% off, 15% off orders over 1,000",
+                s => s > 1000m ? s * 0.15m : s * 0.10m),
+        };
+
+    public static Discount For(CustomerType customer) =>
+        ByCustomer.TryGetValue(customer, out var discount)
+            ? discount
+            : throw new InvalidOperationException($"No discount rule defined for {customer}.");
+}
+
 public static class PriceCalculator
 {
-    public static decimal Total(Order order)
+    public static decimal Total(Order order) => Receipt(order).Total;
+
+    public static Receipt Receipt(Order order)
     {
         var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
-        {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
-        };
-        return subtotal - discount;
+        var rule = Discounts.For(order.Customer);
+        var discount = rule.AmountFor(subtotal);
+        return new Receipt(subtotal, rule.Description, discount, subtotal - discount);
     }
 }
