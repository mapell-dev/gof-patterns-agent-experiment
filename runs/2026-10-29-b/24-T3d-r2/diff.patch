 namespace Shop;
 
-public enum CustomerType { Regular, Loyal }
+public enum CustomerType { Regular, Loyal, Student, Partner }
 
 public record OrderLine(string Sku, decimal UnitPrice, int Quantity);
 
 public record Order(CustomerType Customer, IReadOnlyList<OrderLine> Lines);
 
+// A customer type's discount: the receipt line and the amount taken off a given subtotal.
+public record Discount(string ReceiptLine, Func<decimal, decimal> AmountFor);
+
+public static class Discounts
+{
+    // To add a customer type: add it to CustomerType and give it one entry here.
+    public static Discount For(CustomerType customer) => customer switch
+    {
+        CustomerType.Regular => new("Regular: no discount", _ => 0m),
+        CustomerType.Loyal => new("Loyal: 5% off", subtotal => subtotal * 0.05m),
+        CustomerType.Student => new("Student: 10% off, max 30", subtotal => Math.Min(subtotal * 0.10m, 30m)),
+        CustomerType.Partner => new("Partner: 10% off, 15% over 1,000",
+            subtotal => subtotal * (subtotal > 1000m ? 0.15m : 0.10m)),
+        _ => throw new ArgumentOutOfRangeException(nameof(customer), customer, "No discount rule for this customer type.")
+    };
+}
+
 public static class PriceCalculator
 {
+    public static decimal Subtotal(Order order) => order.Lines.Sum(l => l.UnitPrice * l.Quantity);
+
     public static decimal Total(Order order)
     {
-        var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
-        {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
-        };
-        return subtotal - discount;
+        var subtotal = Subtotal(order);
+        return subtotal - Discounts.For(order.Customer).AmountFor(subtotal);
     }
+
+    public static string DiscountReceiptLine(Order order) => Discounts.For(order.Customer).ReceiptLine;
 }
