--- /dev/null
+++ b/Shop/Discounts.cs
@@ -0,0 +1,34 @@
+namespace Shop;
+
+/// <summary>A discount that applies to orders placed by one customer type.</summary>
+public interface ICustomerDiscount
+{
+    CustomerType Customer { get; }
+
+    /// <summary>The amount to take off the given subtotal.</summary>
+    decimal AmountOff(decimal subtotal);
+}
+
+public abstract class PercentageDiscount(CustomerType customer, decimal rate) : ICustomerDiscount
+{
+    public CustomerType Customer { get; } = customer;
+
+    public decimal AmountOff(decimal subtotal) => subtotal * rate;
+}
+
+public sealed class LoyalDiscount() : PercentageDiscount(CustomerType.Loyal, 0.05m);
+
+public sealed class EmployeeDiscount() : PercentageDiscount(CustomerType.Employee, 0.20m);
+
+/// <summary>
+/// The discounts in effect. To add a customer type: add it to <see cref="CustomerType"/>,
+/// write its discount class, and register it here. Customer types without a discount pay the subtotal.
+/// </summary>
+public static class Discounts
+{
+    public static readonly IReadOnlyList<ICustomerDiscount> All =
+    [
+        new LoyalDiscount(),
+        new EmployeeDiscount(),
+    ];
+}
