+++ b/Shop/Pricing.cs
@@ -6,16 +6,42 @@ public record OrderLine(string Sku, decimal UnitPrice, int Quantity);
 
 public record Order(CustomerType Customer, IReadOnlyList<OrderLine> Lines);
 
+public interface IDiscountStrategy
+{
+    // Returns the discount to take off `amount`, the price left after earlier discounts.
+    decimal DiscountFor(decimal subtotal, decimal amount);
+}
+
+public sealed class NoDiscount : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal, decimal amount) => 0m;
+}
+
+public sealed class LoyalCustomerDiscount : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal, decimal amount) => amount * 0.05m;
+}
+
+public sealed class LargeOrderDiscount : IDiscountStrategy
+{
+    public decimal DiscountFor(decimal subtotal, decimal amount) =>
+        subtotal >= 1000m ? amount * 0.03m : 0m;
+}
+
 public static class PriceCalculator
 {
+    private static readonly IDiscountStrategy LargeOrder = new LargeOrderDiscount();
+
     public static decimal Total(Order order)
     {
         var subtotal = order.Lines.Sum(l => l.UnitPrice * l.Quantity);
-        var discount = order.Customer switch
-        {
-            CustomerType.Loyal => subtotal * 0.05m,
-            _ => 0m
-        };
-        return subtotal - discount;
+        IDiscountStrategy[] discounts = [CustomerDiscount(order.Customer), LargeOrder];
+        return discounts.Aggregate(subtotal, (amount, d) => amount - d.DiscountFor(subtotal, amount));
     }
+
+    private static IDiscountStrategy CustomerDiscount(CustomerType customer) => customer switch
+    {
+        CustomerType.Loyal => new LoyalCustomerDiscount(),
+        _ => new NoDiscount()
+    };
 }
