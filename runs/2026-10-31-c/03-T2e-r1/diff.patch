@@ -12,4 +12,20 @@ public class PriceCalculatorTests
     [Fact]
     public void Loyal_customer_gets_five_percent_off() =>
         Assert.Equal(237.50m, PriceCalculator.Total(OrderOf(CustomerType.Loyal)));
+
+    private static Order OrderWithSubtotal(CustomerType customer, decimal subtotal) =>
+        new(customer, [new OrderLine("A", subtotal, 1)]);
+
+    [Fact]
+    public void Subtotal_just_below_1000_gets_no_large_order_discount() =>
+        Assert.Equal(999.99m, PriceCalculator.Total(OrderWithSubtotal(CustomerType.Regular, 999.99m)));
+
+    [Fact]
+    public void Subtotal_of_1000_gets_three_percent_off() =>
+        Assert.Equal(970m, PriceCalculator.Total(OrderWithSubtotal(CustomerType.Regular, 1000m)));
+
+    [Fact]
+    public void Large_order_discount_applies_after_loyal_discount() =>
+        // 1000 - 5% = 950; 950 - 3% = 921.50
+        Assert.Equal(921.50m, PriceCalculator.Total(OrderWithSubtotal(CustomerType.Loyal, 1000m)));
 }
