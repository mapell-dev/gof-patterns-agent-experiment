@@ -0,0 +1,22 @@
+namespace Shop;
+
+public interface IDiscount
+{
+    /// <summary>The amount to subtract from the given subtotal.</summary>
+    decimal AmountOff(decimal subtotal);
+}
+
+public sealed class NoDiscount : IDiscount
+{
+    public decimal AmountOff(decimal subtotal) => 0m;
+}
+
+public sealed class LoyalDiscount : IDiscount
+{
+    public decimal AmountOff(decimal subtotal) => subtotal * 0.05m;
+}
+
+public sealed class EmployeeDiscount : IDiscount
+{
+    public decimal AmountOff(decimal subtotal) => subtotal * 0.20m;
+}
