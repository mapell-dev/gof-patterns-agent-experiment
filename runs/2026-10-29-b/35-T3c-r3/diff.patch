+using Shop;
+
+public class DiscountTests
+{
+    [Fact]
+    public void Regular_gets_nothing_off()
+    {
+        var rule = new NoDiscount();
+        Assert.Equal(0m, rule.Amount(250m));
+        Assert.Equal("Regular: no discount", rule.Description);
+    }
+
+    [Fact]
+    public void Loyal_gets_five_percent_off()
+    {
+        var rule = new LoyalDiscount();
+        Assert.Equal(12.50m, rule.Amount(250m));
+        Assert.Equal("Loyal: 5% off", rule.Description);
+    }
+
+    [Theory]
+    [InlineData(100, 10)]
+    [InlineData(299, 29.9)]
+    [InlineData(300, 30)]  // exactly at the cap
+    [InlineData(301, 30)]
+    [InlineData(5000, 30)]
+    public void Student_gets_ten_percent_off_capped_at_30(decimal subtotal, decimal expected) =>
+        Assert.Equal(expected, new StudentDiscount().Amount(subtotal));
+
+    [Fact]
+    public void Student_description() =>
+        Assert.Equal("Student: 10% off, max 30", new StudentDiscount().Description);
+
+    [Theory]
+    [InlineData(500, 50)]
+    [InlineData(1000, 100)]        // "up to 1,000" includes 1,000
+    [InlineData(1000.01, 150.0015)] // above 1,000: 15% on the whole order
+    [InlineData(2000, 300)]
+    public void Partner_gets_ten_percent_up_to_1000_and_fifteen_above(decimal subtotal, decimal expected) =>
+        Assert.Equal(expected, new PartnerDiscount().Amount(subtotal));
+
+    [Fact]
+    public void Partner_description() =>
+        Assert.Equal("Partner: 10% off, 15% over 1,000", new PartnerDiscount().Description);
+
+    [Fact]
+    public void Every_customer_type_has_a_registered_discount()
+    {
+        foreach (var type in Enum.GetValues<CustomerType>())
+            Assert.NotNull(Discounts.For(type));
+    }
+}
